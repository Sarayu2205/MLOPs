{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# CSE Employability \u2014 Complete ML + Feast Feature Store Workflow\n",
        "\n",
        "Uses the existing `CSE_Employability_Dataset.xlsx` (100 records).\n",
        "\n",
        "Run cells from top to bottom.\n",
        "\n",
        "**Flow:** Dataset \u2192 Preprocessing \u2192 Feature Selection \u2192 Train/Test \u2192 Random Forest \u2192 Evaluation \u2192 Parquet \u2192 Feast Entity \u2192 Feature View \u2192 Registry \u2192 Feature Service \u2192 Offline Retrieval \u2192 Materialization \u2192 Online Retrieval \u2192 Prediction\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Install libraries"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!pip install -q pandas numpy matplotlib seaborn scikit-learn openpyxl pyarrow feast\n",
        "print(\"Libraries installed successfully.\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Upload dataset"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from google.colab import files\n",
        "uploaded = files.upload()\n",
        "print(\"Uploaded:\", list(uploaded.keys()))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Load dataset"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "DATASET_NAME = \"CSE_Employability_Dataset.xlsx\"\n",
        "df = pd.read_excel(DATASET_NAME)\n",
        "\n",
        "print(\"Shape:\", df.shape)\n",
        "display(df.head())\n",
        "print(\"\\nColumns:\")\n",
        "print(df.columns.tolist())\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Preprocessing"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "print(\"Missing values before:\")\n",
        "display(df.isnull().sum())\n",
        "\n",
        "print(\"Duplicate rows:\", df.duplicated().sum())\n",
        "\n",
        "df = df.drop_duplicates().reset_index(drop=True)\n",
        "\n",
        "# Fill missing values if any\n",
        "for col in df.select_dtypes(include=np.number).columns:\n",
        "    if df[col].isnull().any():\n",
        "        df[col] = df[col].fillna(df[col].median())\n",
        "\n",
        "for col in df.select_dtypes(include=\"object\").columns:\n",
        "    if df[col].isnull().any():\n",
        "        df[col] = df[col].fillna(df[col].mode()[0])\n",
        "\n",
        "print(\"Remaining missing values:\", int(df.isnull().sum().sum()))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Encode categorical variables"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "feature_encoders = {}\n",
        "\n",
        "for col in [\"Gender\", \"Internship\", \"PlacementTraining\"]:\n",
        "    enc = LabelEncoder()\n",
        "    df[col] = enc.fit_transform(df[col].astype(str))\n",
        "    feature_encoders[col] = enc\n",
        "\n",
        "target_encoder = LabelEncoder()\n",
        "df[\"Employability\"] = target_encoder.fit_transform(df[\"Employability\"].astype(str))\n",
        "\n",
        "print(\"Target mapping:\")\n",
        "for i, label in enumerate(target_encoder.classes_):\n",
        "    print(i, \"=\", label)\n",
        "\n",
        "display(df.head())\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Define X and y"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "X = df.drop(columns=[\"StudentID\", \"Name\", \"Employability\"])\n",
        "y = df[\"Employability\"]\n",
        "\n",
        "print(\"X shape:\", X.shape)\n",
        "print(\"y shape:\", y.shape)\n",
        "print(\"Features:\", X.columns.tolist())\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Train-test split"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y,\n",
        "    test_size=0.20,\n",
        "    random_state=42,\n",
        "    stratify=y\n",
        ")\n",
        "\n",
        "print(\"Training rows:\", len(X_train))\n",
        "print(\"Testing rows:\", len(X_test))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 8. Feature scaling"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "X_train_scaled_df = pd.DataFrame(\n",
        "    X_train_scaled, columns=X.columns, index=X_train.index\n",
        ")\n",
        "X_test_scaled_df = pd.DataFrame(\n",
        "    X_test_scaled, columns=X.columns, index=X_test.index\n",
        ")\n",
        "\n",
        "print(\"Scaling completed.\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 9. Random Forest model"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from sklearn.ensemble import RandomForestClassifier\n",
        "\n",
        "rf_model = RandomForestClassifier(\n",
        "    n_estimators=200,\n",
        "    max_depth=8,\n",
        "    class_weight=\"balanced\",\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "rf_model.fit(X_train_scaled_df, y_train)\n",
        "y_pred = rf_model.predict(X_test_scaled_df)\n",
        "\n",
        "print(\"Random Forest trained successfully.\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 10. Accuracy and classification report"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from sklearn.metrics import accuracy_score, classification_report\n",
        "\n",
        "accuracy = accuracy_score(y_test, y_pred)\n",
        "\n",
        "print(f\"Accuracy: {accuracy * 100:.2f}%\")\n",
        "print(\"\\nClassification Report:\")\n",
        "print(classification_report(\n",
        "    y_test, y_pred,\n",
        "    target_names=target_encoder.classes_,\n",
        "    zero_division=0\n",
        "))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 11. Confusion matrix"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from sklearn.metrics import confusion_matrix\n",
        "\n",
        "cm = confusion_matrix(y_test, y_pred)\n",
        "\n",
        "plt.figure(figsize=(7, 5))\n",
        "sns.heatmap(\n",
        "    cm, annot=True, fmt=\"d\",\n",
        "    xticklabels=target_encoder.classes_,\n",
        "    yticklabels=target_encoder.classes_\n",
        ")\n",
        "plt.title(\"Confusion Matrix - Employability Prediction\")\n",
        "plt.xlabel(\"Predicted\")\n",
        "plt.ylabel(\"Actual\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 12. Feature importance"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "importance = pd.DataFrame({\n",
        "    \"Feature\": X.columns,\n",
        "    \"Importance\": rf_model.feature_importances_\n",
        "}).sort_values(\"Importance\", ascending=False)\n",
        "\n",
        "display(importance)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "plt.figure(figsize=(10, 7))\n",
        "plt.barh(importance[\"Feature\"], importance[\"Importance\"])\n",
        "plt.xlabel(\"Importance\")\n",
        "plt.ylabel(\"Feature\")\n",
        "plt.title(\"Random Forest Feature Importance\")\n",
        "plt.gca().invert_yaxis()\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 13. Select top features"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "TOP_N = min(10, len(importance))\n",
        "selected_features = importance.head(TOP_N)[\"Feature\"].tolist()\n",
        "\n",
        "print(\"Selected top features:\")\n",
        "for i, f in enumerate(selected_features, 1):\n",
        "    print(f\"{i}. {f}\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 14. Create Parquet feature data"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "feature_df = df[[\"StudentID\"] + selected_features].copy()\n",
        "\n",
        "base_time = pd.Timestamp(\"2026-01-01\", tz=\"UTC\")\n",
        "\n",
        "feature_df[\"event_timestamp\"] = (\n",
        "    base_time + pd.to_timedelta(feature_df[\"StudentID\"], unit=\"s\")\n",
        ")\n",
        "feature_df[\"created_timestamp\"] = (\n",
        "    feature_df[\"event_timestamp\"] + pd.Timedelta(seconds=1)\n",
        ")\n",
        "\n",
        "feature_df.to_parquet(\"student_features.parquet\", index=False)\n",
        "\n",
        "print(\"Feature data saved successfully.\")\n",
        "display(feature_df.head())\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 15. Create a clean Feast repository"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import shutil\n",
        "\n",
        "REPO_PATH = \"/content/employability_feast\"\n",
        "\n",
        "if os.path.exists(REPO_PATH):\n",
        "    shutil.rmtree(REPO_PATH)\n",
        "\n",
        "os.makedirs(os.path.join(REPO_PATH, \"data\"), exist_ok=True)\n",
        "\n",
        "shutil.copy(\n",
        "    \"student_features.parquet\",\n",
        "    os.path.join(REPO_PATH, \"data\", \"student_features.parquet\")\n",
        ")\n",
        "\n",
        "print(\"Repository:\", REPO_PATH)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 16. Create feature_store.yaml"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "feature_store_yaml = '''\n",
        "project: employability_project\n",
        "registry: data/registry.db\n",
        "provider: local\n",
        "\n",
        "online_store:\n",
        "  type: sqlite\n",
        "  path: data/online_store.db\n",
        "'''\n",
        "\n",
        "with open(os.path.join(REPO_PATH, \"feature_store.yaml\"), \"w\") as f:\n",
        "    f.write(feature_store_yaml.strip() + \"\\n\")\n",
        "\n",
        "print(\"feature_store.yaml created.\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 17. Create Feast Entity, Feature View and Feature Service"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "field_lines = []\n",
        "\n",
        "for feature in selected_features:\n",
        "    dtype = \"Float32\" if feature == \"CGPA\" else \"Int64\"\n",
        "    field_lines.append(\n",
        "        f'        Field(name=\"{feature}\", dtype={dtype}),'\n",
        "    )\n",
        "\n",
        "features_py = f'''\n",
        "from datetime import timedelta\n",
        "from feast import Entity, FeatureView, Field, FeatureService\n",
        "from feast.types import Int64, Float32\n",
        "from feast.infra.offline_stores.file_source import FileSource\n",
        "\n",
        "student = Entity(\n",
        "    name=\"student\",\n",
        "    join_keys=[\"StudentID\"],\n",
        "    description=\"CSE student entity\"\n",
        ")\n",
        "\n",
        "student_source = FileSource(\n",
        "    name=\"student_employability_source\",\n",
        "    path=\"data/student_features.parquet\",\n",
        "    timestamp_field=\"event_timestamp\",\n",
        "    created_timestamp_column=\"created_timestamp\"\n",
        ")\n",
        "\n",
        "student_features = FeatureView(\n",
        "    name=\"student_employability_features\",\n",
        "    entities=[student],\n",
        "    ttl=timedelta(days=365),\n",
        "    schema=[\n",
        "{chr(10).join(field_lines)}\n",
        "    ],\n",
        "    source=student_source,\n",
        "    online=True\n",
        ")\n",
        "\n",
        "student_employability_service = FeatureService(\n",
        "    name=\"student_employability_service\",\n",
        "    features=[student_features]\n",
        ")\n",
        "'''\n",
        "\n",
        "with open(os.path.join(REPO_PATH, \"features.py\"), \"w\") as f:\n",
        "    f.write(features_py)\n",
        "\n",
        "print(\"features.py created.\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 18. Verify Feast repository"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "\n",
        "for root, dirs, files_in_dir in os.walk(REPO_PATH):\n",
        "    print(root)\n",
        "    for name in files_in_dir:\n",
        "        print(\"  \", name)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 19. Apply Feast"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%cd /content/employability_feast\n",
        "!feast apply\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 20. Check Entity"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%cd /content/employability_feast\n",
        "!feast entities list\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 21. Check Feature View"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%cd /content/employability_feast\n",
        "!feast feature-views list\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 22. Check Feature Service"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%cd /content/employability_feast\n",
        "!feast feature-services list\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 23. Load FeatureStore"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from feast import FeatureStore\n",
        "\n",
        "fs = FeatureStore(repo_path=REPO_PATH)\n",
        "print(\"FeatureStore loaded successfully.\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 24. Offline Store \u2014 Historical Feature Retrieval"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "entity_df = feature_df[[\"StudentID\", \"event_timestamp\"]].copy()\n",
        "\n",
        "feature_refs = [\n",
        "    f\"student_employability_features:{feature}\"\n",
        "    for feature in selected_features\n",
        "]\n",
        "\n",
        "historical_df = fs.get_historical_features(\n",
        "    entity_df=entity_df,\n",
        "    features=feature_refs\n",
        ").to_df()\n",
        "\n",
        "print(\"Historical features retrieved successfully.\")\n",
        "print(\"Shape:\", historical_df.shape)\n",
        "display(historical_df.head())\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 25. Add target label"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "historical_df = historical_df.merge(\n",
        "    df[[\"StudentID\", \"Employability\"]],\n",
        "    on=\"StudentID\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "display(historical_df.head())\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 26. Train model using Feast-retrieved features"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "X_feast = historical_df[selected_features]\n",
        "y_feast = historical_df[\"Employability\"]\n",
        "\n",
        "Xf_train, Xf_test, yf_train, yf_test = train_test_split(\n",
        "    X_feast, y_feast,\n",
        "    test_size=0.20,\n",
        "    random_state=42,\n",
        "    stratify=y_feast\n",
        ")\n",
        "\n",
        "feast_model = RandomForestClassifier(\n",
        "    n_estimators=200,\n",
        "    max_depth=8,\n",
        "    class_weight=\"balanced\",\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "feast_model.fit(Xf_train, yf_train)\n",
        "yf_pred = feast_model.predict(Xf_test)\n",
        "\n",
        "feast_accuracy = accuracy_score(yf_test, yf_pred)\n",
        "print(f\"Feast-feature model accuracy: {feast_accuracy * 100:.2f}%\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 27. Evaluate Feast model"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "feast_cm = confusion_matrix(yf_test, yf_pred)\n",
        "\n",
        "plt.figure(figsize=(7, 5))\n",
        "sns.heatmap(\n",
        "    feast_cm, annot=True, fmt=\"d\",\n",
        "    xticklabels=target_encoder.classes_,\n",
        "    yticklabels=target_encoder.classes_\n",
        ")\n",
        "plt.title(\"Confusion Matrix - Model Using Feast Features\")\n",
        "plt.xlabel(\"Predicted\")\n",
        "plt.ylabel(\"Actual\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(classification_report(\n",
        "    yf_test, yf_pred,\n",
        "    target_names=target_encoder.classes_,\n",
        "    zero_division=0\n",
        "))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 28. Materialize to Online Store"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "materialize_start = pd.Timestamp(\"2025-12-31\", tz=\"UTC\").to_pydatetime()\n",
        "materialize_end = pd.Timestamp(\"2026-01-02\", tz=\"UTC\").to_pydatetime()\n",
        "\n",
        "fs.materialize(\n",
        "    start_date=materialize_start,\n",
        "    end_date=materialize_end\n",
        ")\n",
        "\n",
        "print(\"Features materialized successfully.\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 29. Online Feature Retrieval"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "student_id_for_test = int(df.iloc[0][\"StudentID\"])\n",
        "\n",
        "online_result = fs.get_online_features(\n",
        "    features=feature_refs,\n",
        "    entity_rows=[{\"StudentID\": student_id_for_test}]\n",
        ").to_dict()\n",
        "\n",
        "print(\"StudentID:\", student_id_for_test)\n",
